# Konfigurasi Server Produksi / cPanel / VPS
# Salin file ini menjadi .env (atau jalankan install.php lewat browser untuk membuat .env otomatis)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edu_presensi_saas
DB_USER=root
DB_PASS=

# Zona waktu aplikasi & database (WITA: Asia/Makassar +08:00 | WIB: Asia/Jakarta +07:00 | WIT: Asia/Jayapura +09:00)
APP_TIMEZONE=Asia/Makassar
DB_TIMEZONE=+08:00

# Kosongkan agar path URL otomatis menyesuaikan root domain maupun subfolder di server mana pun
APP_BASE_PATH=
